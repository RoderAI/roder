  {
    "id": "contact_form",
    "covers": "fill three fields, submit, and the values reach the POST",
    "page": "contact.html",
    "goal": "Send a message through the contact form as Ada Lovelace (ada@example.com) saying: Hello & welcome",
    "values": {
      "Name": "Ada Lovelace",
      "Email": "ada@example.com",
      "Message": "Hello & welcome"
    },
    "expect": {
      "status": "done",
      "stopped": false,
      "url_ends_with": "/submit/contact",
      "title": "Thanks",
      "posts": [
        {
          "path": "/submit/contact",
          "fields": {
            "name": "Ada Lovelace",
            "email": "ada@example.com",
            "message": "Hello & welcome"
          }
        }
      ]
    },
    "script": {
      "plan": [
        {
          "fill": "Name"
        },
        {
          "fill": "Email"
        },
        {
          "fill": "Message"
        },
        {
          "click": "Send message"
        }
      ],
      "expect": {
        "actions": [
          "fill Name",
          "fill Email",
          "fill Message",
          "click Send message"
        ],
        "model_calls": 5
      }
    }
  },
